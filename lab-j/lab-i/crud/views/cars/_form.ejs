<div class="form-group">
    <label for="subject">Subject</label>
    <input type="text" id="subject" name="subject" value="<%= car ? car.subject : '' %>">
</div>

<div class="form-group">
    <label for="content">Content</label>
    <textarea id="content" name="content"><%= car ? car.content : '' %></textarea>
</div>

<div class="form-group">
    <label for="carModel">Car model</label>
    <input type="text" id="carModel" name="carModel" value="<%= car ? car.carModel : '' %>">
</div>

<div class="form-group">
    <label></label>
    <input type="submit" value="Submit">
</div>
