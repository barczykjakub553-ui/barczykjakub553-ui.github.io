<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <h1><%= title %></h1>
    <a href="/cars/create">Create new</a>
    <ul class="index-list">
      <% cars.forEach(function(car) { %>
        <li>
          <h3><%= car.subject %></h3>
          <p class="car-model">Car model: <%= car.carModel %></p>
          <ul class="action-list">
            <li><a href="/cars/<%= car.id %>">Details</a></li>
            <li><a href="/cars/<%= car.id %>/edit">Edit</a></li>
            <li>
                <form action="/cars/<%= car.id %>/delete" method="POST" style="display:inline;">
                    <button type="submit" onclick="return confirm('Are you sure?')">Delete</button>
                </form>
            </li>
          </ul>
        </li>
      <% }); %>
    </ul>
  </body>
</html>
